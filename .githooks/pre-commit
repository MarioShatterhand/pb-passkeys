#!/bin/sh
# Blocks commits that contain secrets. Enable once per clone with:
#   git config core.hooksPath .githooks
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
	echo "pre-commit: gitleaks is not installed, refusing to commit." >&2
	echo "Install it from https://github.com/gitleaks/gitleaks/releases" >&2
	exit 1
fi

exec gitleaks git --pre-commit --staged --redact --no-banner
